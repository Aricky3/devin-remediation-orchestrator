# ---- Devin API (v3 organization sessions) ----
# Service-user token (starts with cog_). Create at Settings > Service Users.
DEVIN_API_KEY=cog_your_service_user_token
# Organization id (from /v3/self or Settings > Service Users).
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_BASE_URL=https://api.devin.ai/v3
# Cost guardrail per remediation session.
DEVIN_MAX_ACU_LIMIT=25

# ---- GitHub ----
# Token with repo scope on the watched repo (issues:read/write, pull_requests:read).
GITHUB_TOKEN=ghp_your_token
GITHUB_REPO=Aricky3/superset
# Optional: shared secret to verify inbound webhook signatures.
GITHUB_WEBHOOK_SECRET=

# ---- Workflow ----
REMEDIATE_LABEL=devin-remediate
IN_PROGRESS_LABEL=devin-in-progress
DONE_LABEL=devin-remediated

# ---- Scheduling / concurrency ----
SCAN_INTERVAL_SECONDS=60
POLL_INTERVAL_SECONDS=30
MAX_CONCURRENT_SESSIONS=5
SCANNER_ENABLED=true

# ---- Modes ----
# DRY_RUN=true simulates Devin sessions locally (no ACUs, no network) for demos/CI.
DRY_RUN=false
LOG_LEVEL=INFO
DATABASE_PATH=data/orchestrator.db
